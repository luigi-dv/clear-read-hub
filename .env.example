# Optional: `docker compose up` works without a .env file.
# Copy to .env to override the development defaults. Every variable is documented
# in src/service_config.py.

# Service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Values starting with `insecure-` are rejected when ENVIRONMENT=production.
JWT_SECRET_KEY=insecure-change-me-to-a-long-random-string-of-32-chars
JWT_EXPIRES_MINUTES=15

# CORS, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MongoDB. The root user is only created when the data volume is first initialized:
# after changing it, reset the data with `docker compose down -v`.
MONGO_ROOT_USERNAME=clearreadhub
MONGO_ROOT_PASSWORD=clearreadhub
# Used when running the API outside Docker (Compose builds its own URI)
MONGODB_URI=mongodb://clearreadhub:clearreadhub@localhost:27017/?authSource=admin
MONGODB_DATABASE_NAME=clearreadhub

# Storage: local or azure
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
# Azurite (local Azure emulator) uses its well known development account
AZ_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZ_STORAGE_CONTAINER_NAME=documents

# Documents
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=500

# Queue: inline (no worker needed) or rq
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
